# ===== Price Engine settings (local test). Copy to .env, or just run:  python engine_ctl.py init =====
# Never commit or share .env or the wallet folder.

# ── Engine ───────────────────────────────────────────────
# development = local test (UI gets its keys automatically). production = stricter secret checks, no auto-keys.
ENGINE_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
# Swagger page at /docs
ENABLE_DOCS=true
# The simple trading UI at /ui/
UI_ENABLED=true
LOG_DIR=./logs
DATA_DIR=./data
LOG_LEVEL=INFO

# ── Oracle Autonomous Database (same names as your other project) ─────
# Put the unzipped wallet files in the wallet/ folder.
ORACLE_ADB_USER=
ORACLE_ADB_PASSWORD=
# TNS alias from wallet/tnsnames.ora. For this engine use the _tp or _low alias (many small requests),
# for example etldb_tp or etldb_low.
ORACLE_ADB_DSN=
ORACLE_ADB_WALLET_DIR=./wallet
ORACLE_ADB_WALLET_PASSWORD=
# Always Free databases allow only a few sessions; keep this small
DB_POOL_MAX=5

# ── OANDA (practice) ─────────────────────────────────────
# Leave empty to run the API/UI without the live stream.
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_API_URL=https://api-fxpractice.oanda.com
OANDA_STREAM_URL=https://stream-fxpractice.oanda.com
STREAM_STALL_SECONDS=15
STREAM_RECONNECT_MAX_BACKOFF=60

# ── Pairs and history ────────────────────────────────────
# Only used to fill an empty pairs table; add more later in the UI (Console page) or with scripts/add_pair
SEED_PAIRS=EUR_USD,GBP_USD,USD_JPY,AUD_USD,USD_CAD,XAU_USD,EUR_GBP
# History downloaded from OANDA when a pair is new (0 = none)
BACKFILL_DAYS_NEW_PAIR=7
# Fill gaps after every stream reconnect
BACKFILL_ON_RECONNECT=true

# ── Candle engine ────────────────────────────────────────
# Must include 1m. The analysis screen always adds 1m, 5m, 15m, 30m and 1h.
LIVE_TIMEFRAMES=1m,5m,15m,30m,1h,4h
# How often forming candles are pushed to websocket clients
CANDLE_PUBLISH_INTERVAL_MS=250
# Session windows in the analysis screen. local = follow the real Tokyo/London/New York clocks (they move by an hour in IST
# when London or the US change their clocks); fixed = the exact IST times you gave.
SESSION_MODE=local
CANDLE_CLOSE_GRACE_MS=2000
DB_FLUSH_INTERVAL_MS=1000

# ── Storage ──────────────────────────────────────────────
# Raw ticks fill the free 20 GB database fast. Keep false unless you need tick history.
STORE_TICKS=false
TICK_RETENTION_DAYS=2
# 0 = keep 1m candles forever
CANDLE_1M_RETENTION_DAYS=0

# ── Auth (generated for you by: python engine_ctl.py init) ──
ADMIN_API_KEY=
API_KEY_PEPPER=
WS_TOKEN_SECRET=
WS_TOKEN_TTL_SECONDS=60
# Empty = no Origin check (fine locally)
WS_ALLOWED_ORIGINS=
WS_MAX_CONNECTIONS=5000
WS_MAX_CONNECTIONS_PER_IP=200
WS_SEND_QUEUE_MAX=500
WS_AUTH_TIMEOUT_SECONDS=5
WS_MAX_SESSION_SECONDS=86400
WS_MAX_SUBSCRIPTIONS=200

# ── API behaviour ────────────────────────────────────────
MAX_CANDLES_PER_REQUEST=5000
MAX_TICKS_PER_REQUEST=20000
CACHE_TTL_LATEST_MS=1000
CACHE_TTL_HISTORY_S=60
CACHE_MAX_ENTRIES=2000

# ── Alerts (optional Slack/Discord webhook) ──────────────
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_SECONDS=900
STALE_PAIR_SECONDS=120
